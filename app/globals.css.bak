@import "tailwindcss";

:root {
  --background: #000000;
  --foreground: #e8e4de;
  --accent: #e8e4de;
  --accent-warm: #ff6b35;
  --accent-warm-dim: #cc5a30;
  --surface: #0a0a0a;
  --surface-2: #111111;
  --border: rgba(255, 255, 255, 0.08);
  --frost: rgba(255, 255, 255, 0.04);
  --frost-strong: rgba(255, 255, 255, 0.08);

  /* ── Text hierarchy (contrast on #000) ── */
  --foreground-secondary: #b0aca6;   /* ~8.5:1 — body copy */
  --foreground-tertiary: #858178;    /* ~5.0:1 — labels, captions */
  --foreground-muted: #605c58;       /* ~3.1:1 — fine print */
  --foreground-faint: #3d3a37;       /* ~1.8:1 — decorative only */

  /* ── Radius tokens ── */
  --radius-container: 1rem;          /* 16px — section containers, card grids */
  --radius-card: 0.75rem;            /* 12px — batch cards, comparison cards */
  --radius-button: 9999px;           /* pill buttons (hero, nav, faq, cta) */
  --radius-button-rect: 0.5rem;      /* 8px — rectangular buttons (pricing, cookie) */

  /* ── Duration tokens ── */
  --duration-fast: 150ms;
  --duration-normal: 200ms;
  --duration-slow: 300ms;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-accent: var(--accent);
  --color-accent-warm: var(--accent-warm);
  --color-accent-warm-dim: var(--accent-warm-dim);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-border: var(--border);
  --color-frost: var(--frost);
  --color-frost-strong: var(--frost-strong);
  --color-foreground-secondary: var(--foreground-secondary);
  --color-foreground-tertiary: var(--foreground-tertiary);
  --color-foreground-muted: var(--foreground-muted);
  --color-foreground-faint: var(--foreground-faint);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --radius-container: var(--radius-container);
  --radius-card: var(--radius-card);
  --radius-button: var(--radius-button);
  --radius-button-rect: var(--radius-button-rect);
}

* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  font-weight: 300;
  letter-spacing: -0.01em;
}

::selection {
  background: rgba(255, 107, 53, 0.3);
  color: #fff;
}

/* ── Frost glass ── */
.frost {
  background: rgba(10, 10, 10, 0.7);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 1px solid var(--border);
}

.frost-light {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
}

/* ── Typography ── */
.heading-xl {
  font-weight: 200;
  letter-spacing: -0.025em;
  line-height: 1.05;
}

.heading-lg {
  font-weight: 200;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.heading-md {
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

@media (min-width: 768px) {
  .heading-xl { letter-spacing: -0.035em; line-height: 1; }
  .heading-lg { letter-spacing: -0.03em; line-height: 1.1; }
  .heading-md { letter-spacing: -0.025em; line-height: 1.15; }
}

.label {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

@media (min-width: 640px) {
  .label {
    font-size: 12px;
  }
}

.body-lg {
  font-weight: 300;
  line-height: 1.7;
  letter-spacing: -0.01em;
}

/* ── Reusable text components (overridable by utilities) ── */
@layer components {
  .text-body {
    @apply text-sm text-foreground-secondary leading-relaxed font-normal;
  }
  .text-body-lg {
    @apply text-base sm:text-lg text-foreground-secondary leading-relaxed font-normal;
  }
  .text-caption {
    @apply text-xs text-foreground-tertiary leading-relaxed;
  }
  .text-fine {
    @apply text-xs text-foreground-muted leading-relaxed;
  }
  .section-padding {
    @apply py-20 sm:py-32 md:py-40 px-5 sm:px-6;
  }
}

/* ── Transition utilities ── */
@utility transition-interactive {
  transition-property: color, background-color, border-color, opacity, transform;
  transition-duration: var(--duration-normal);
  transition-timing-function: ease-out;
}

@utility transition-emphasis {
  transition-property: all;
  transition-duration: var(--duration-slow);
  transition-timing-function: ease-out;
}

/* ── Subtle divider ── */
.divider {
  height: 1px;
  background: var(--border);
}

/* ── Warm glow (used sparingly) ── */
.glow-warm {
  box-shadow: 0 0 80px rgba(255, 107, 53, 0.08), 0 0 160px rgba(255, 107, 53, 0.03);
}

/* ── Gradient text ── */
.gradient-text {
  background: linear-gradient(135deg, #e8e4de 0%, #ff6b35 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Pulse ── */
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.animate-pulse-soft {
  animation: pulse-soft 2s ease-in-out infinite;
}

/* ── Fade up ── */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-up {
  animation: fade-up 0.5s ease-out forwards;
}
